DATABASE_URL=postgresql://postgres:123456@localhost:5432/db?sslmode=disable
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
DATABASE_MAX_CONNS=20
OIDC_ISSUER_URL=http://localhost:8081/realms/wager-challenge
OIDC_AUDIENCE=wager-api
KEYCLOAK_PUBLIC_URL=http://localhost:8081
# Development credentials only, imported when the dedicated realm is created.
PROVIDER_A_CLIENT_SECRET=provider-a-local-secret
PROVIDER_B_CLIENT_SECRET=provider-b-local-secret
INTERNAL_SERVICE_CLIENT_SECRET=internal-service-local-secret
# Optional real integration tests; use a dedicated migrated PostgreSQL database.
POSTGRES_TEST_DATABASE_URL=
KEYCLOAK_TEST_ISSUER_URL=http://localhost:8081/realms/wager-challenge
SQS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_INPUT_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_QUEUE_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_CONSUMER_NAME=wager-transaction-consumer
SQS_RECEIVE_WAIT=20s
SQS_VISIBILITY_TIMEOUT=30s
SQS_PROCESSING_TIMEOUT=20s
SQS_OPERATION_TIMEOUT=5s
SQS_IDLE_DELAY=1s
SQS_MAX_RECEIVE_COUNT=5
# Optional explicit URLs override resolution by queue name.
SQS_INPUT_QUEUE_URL=
SQS_DLQ_QUEUE_URL=
SQS_EVENTS_QUEUE_URL=
# Set alongside POSTGRES_TEST_DATABASE_URL to enable real messaging tests.
SQS_TEST_ENDPOINT_URL=
OUTBOX_POLL_INTERVAL=1s
OUTBOX_OPERATION_TIMEOUT=15s
PENDING_REFERENCE_POLL_INTERVAL=1s
PENDING_REFERENCE_OPERATION_TIMEOUT=15s
PENDING_REFERENCE_BATCH_SIZE=10
STARTUP_TIMEOUT=15s
SHUTDOWN_TIMEOUT=20s
LOG_LEVEL=info
