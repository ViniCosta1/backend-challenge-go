{
  "realm": "wager-challenge",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [{ "name": "provider" }, { "name": "internal" }]
  },
  "clientScopes": [
    {
      "name": "wager-api",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "wager-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "wager-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "service-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "wager-api",
      "protocol": "openid-connect",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "provider-a",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${PROVIDER_A_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["wager-api"]
    },
    {
      "clientId": "provider-b",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${PROVIDER_B_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["wager-api"]
    },
    {
      "clientId": "internal-service",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${INTERNAL_SERVICE_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["wager-api"]
    },
    {
      "clientId": "auth-expiry-test",
      "enabled": true,
      "protocol": "openid-connect",
      "secret": "auth-expiry-test-local-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["wager-api"],
      "attributes": { "access.token.lifespan": "2" }
    },
    {
      "clientId": "auth-no-role-test",
      "enabled": true,
      "protocol": "openid-connect",
      "secret": "auth-no-role-test-local-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["wager-api"]
    },
    {
      "clientId": "auth-wrong-audience-test",
      "enabled": true,
      "protocol": "openid-connect",
      "secret": "auth-wrong-audience-test-local-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": []
    }
  ],
  "users": [
    { "username": "service-account-provider-a", "enabled": true, "serviceAccountClientId": "provider-a", "realmRoles": ["provider"] },
    { "username": "service-account-provider-b", "enabled": true, "serviceAccountClientId": "provider-b", "realmRoles": ["provider"] },
    { "username": "service-account-internal-service", "enabled": true, "serviceAccountClientId": "internal-service", "realmRoles": ["internal"] },
    { "username": "service-account-auth-expiry-test", "enabled": true, "serviceAccountClientId": "auth-expiry-test", "realmRoles": ["provider"] },
    { "username": "service-account-auth-no-role-test", "enabled": true, "serviceAccountClientId": "auth-no-role-test" },
    { "username": "service-account-auth-wrong-audience-test", "enabled": true, "serviceAccountClientId": "auth-wrong-audience-test", "realmRoles": ["provider"] }
  ]
}
